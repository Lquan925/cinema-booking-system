# URL kết nối MySQL (Sử dụng cổng 3307 như đã cấu hình trong Docker)
SQLALCHEMY_DATABASE_URI=mysql+pymysql://cinema_user:cinema_password@localhost:3307/cinema_db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# URL kết nối Redis
REDIS_URL=redis://localhost:6379/0

# Khóa bí mật cho Flask (Dùng để mã hóa session sau này)
SECRET_KEY=super-secret-key-cinema-2026