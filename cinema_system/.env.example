# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG CINEMA BOOKING
# ==============================================================================
# Sao chép file này thành .env trước khi khởi chạy ứng dụng:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH DATABASE (MySQL)
# ------------------------------------------------------------------------------
# Lưu ý: docker-compose ánh xạ cổng container 3306 ra máy host ở cổng 3307
# Định dạng: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
SQLALCHEMY_DATABASE_URI=mysql+pymysql://cinema_user:cinema_password@localhost:3307/cinema_db

# Vô hiệu hóa tính năng theo dõi sửa đổi của SQLAlchemy để tiết kiệm tài nguyên
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH REDIS (Cache & Giữ ghế realtime)
# ------------------------------------------------------------------------------
# Kết nối Redis trên cổng mặc định 6379, database số 0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH FLASK APPLICATION
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để mã hóa session, CSRF tokens, v.v.
# Hãy thay đổi thành chuỗi ký tự bí mật, ngẫu nhiên và an toàn trên môi trường thực tế.
SECRET_KEY=your-super-secret-key-change-in-production
